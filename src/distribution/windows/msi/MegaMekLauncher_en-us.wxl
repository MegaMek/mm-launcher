<!-- English (base) strings for the MSI's own dialogs in ui.wxs, referenced there as
     !(loc.Id) and passed to "wix build" with -loc. The setup .exe shows its own
     screens from ../bundle/theme.wxl; these dialogs appear when the MSI runs on its own.

     To add a translation: copy this file to MegaMekLauncher_<culture>.wxl (for
     example MegaMekLauncher_de-de.wxl), set Culture (and Codepage, e.g. 1251 for
     ru-ru) on WixLocalization, and translate only each Value. Keep every Id
     and bracketed [Property] reference. Shipping it also needs a build change, since
     the build makes one English MSI (one MSI per language or a language transform). -->
<WixLocalization Culture="en-us" Codepage="1252"
                 xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <!-- Shared buttons -->
  <String Id="MmlUiButtonAbort" Value="Abort"/>
  <String Id="MmlUiButtonCancel" Value="Cancel"/>
  <String Id="MmlUiButtonIgnore" Value="Ignore"/>
  <String Id="MmlUiButtonNo" Value="No"/>
  <String Id="MmlUiButtonOk" Value="OK"/>
  <String Id="MmlUiButtonRetry" Value="Retry"/>
  <String Id="MmlUiButtonYes" Value="Yes"/>
  <String Id="MmlUiButtonCancelSetup" Value="Cancel setup"/>
  <String Id="MmlUiButtonInstall" Value="Install"/>
  <String Id="MmlUiButtonFinish" Value="Finish"/>
  <String Id="MmlUiButtonClose" Value="Close"/>

  <!-- Window title of the welcome, error, cancelled and failed dialogs -->
  <String Id="MmlUiSetupTitle" Value="MegaMek Launcher Setup"/>

  <!-- Files in use -->
  <String Id="MmlUiFilesInUseTitle" Value="Files in Use"/>
  <String Id="MmlUiFilesInUseMessage" Value="Close these applications to continue installing MegaMek Launcher:"/>

  <!-- Welcome -->
  <String Id="MmlUiWelcomeDetail" Value="Install MegaMek Launcher for this user in:"/>
  <String Id="MmlUiWelcomeDesktopShortcut" Value="Create a desktop shortcut"/>

  <!-- Progress: used as both the window title and the heading -->
  <String Id="MmlUiProgressTitle" Value="Installing MegaMek Launcher"/>
  <String Id="MmlUiProgressStatus" Value="Setting up MegaMek Launcher..."/>
  <String Id="MmlUiProgressBar" Value="Progress"/>

  <!-- Finished -->
  <String Id="MmlUiExitTitle" Value="MegaMek Launcher Setup Complete"/>
  <String Id="MmlUiExitInstalled" Value="MegaMek Launcher is installed."/>
  <String Id="MmlUiExitLaunch" Value="Launch MegaMek Launcher"/>

  <!-- Failed or cancelled -->
  <String Id="MmlUiFatalErrorMessage" Value="Setup could not finish. No launcher was started."/>
  <String Id="MmlUiUserExitMessage" Value="Setup was cancelled. No launcher was started."/>
</WixLocalization>
