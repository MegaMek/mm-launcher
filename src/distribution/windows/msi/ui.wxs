<!-- WiX v7 installer UI. No InstallDirDlg: the setup bundle offers the folder
     choice and passes it in LAUNCHER_INSTALL_FOLDER; a direct msiexec install
     uses the remembered folder or the per-user default. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <Binary Id="WizardDialogArt" SourceFile="!(bindpath.Resources)wizard-dialog.bmp"/>
    <Binary Id="WizardBannerArt" SourceFile="!(bindpath.Resources)wizard-banner.bmp"/>
    <Property Id="LAUNCH_AFTER_INSTALL" Value="1"/>
    <Property Id="LAUNCHER_DESKTOP_SHORTCUT" Value="1"/>
    <!-- MegaMekLauncher.wxs owns the DesktopFolder shortcut. Its component is
         conditional on LAUNCHER_DESKTOP_SHORTCUT; only persist the opt-out,
         not a second shortcut. -->
    <Property Id="LAUNCHER_DESKTOP_OPTOUT">
      <RegistrySearch Id="PreviousDesktopOptOut" Root="HKCU"
                      Key="Software\MegaMek\MegaMek Launcher\Installer"
                      Name="DesktopShortcutOptOut" Type="raw"/>
    </Property>
    <CustomAction Id="RestoreDesktopOptOut" Property="LAUNCHER_DESKTOP_SHORTCUT"
                  Value="{}"/>
    <!-- Upgrades, including the launcher's silent self-update, stay in the
         recorded folder (MegaMekLauncher.wxs reads it). Directory properties
         stay empty until CostFinalize, so an empty INSTALLDIR here means the
         command line did not choose a folder explicitly. -->
    <CustomAction Id="RestoreInstallDir" Property="INSTALLDIR"
                  Value="[LAUNCHER_PREVIOUS_INSTALLDIR]"/>
    <!-- Built by the windowsInstallerFolderCheck Gradle task (WiX 7 DTF, C#).
         Turns LAUNCHER_INSTALL_FOLDER into INSTALLDIR (always a dedicated
         "MegaMek Launcher" folder) or fails setup before anything changes when
         uninstall could not safely delete that folder. -->
    <Binary Id="LauncherFolderCA" SourceFile="$(LauncherFolderCheck)"/>
    <CustomAction Id="ResolveInstallFolder" BinaryRef="LauncherFolderCA"
                  DllEntry="ResolveInstallFolder" Execute="immediate" Return="check"/>
    <ComponentGroup Id="LauncherUiState" Directory="INSTALLDIR">
      <Component Id="DesktopOptOutPreference" Guid="8B67C1E0-7B4B-4DC3-95D0-F19EBA63BB36"
                 Condition="NOT LAUNCHER_DESKTOP_SHORTCUT">
        <RegistryValue Root="HKCU" Key="Software\MegaMek\MegaMek Launcher\Installer"
                       Name="DesktopShortcutOptOut" Type="string" Value="1" KeyPath="yes"/>
      </Component>
      <!-- Remove only the empty installer-owned Programs directory; never its
           contents or the containing LocalAppDataFolder. -->
      <Component Id="LauncherProgramsFolderCleanup" Directory="LauncherProgramsFolder"
                 Guid="B65FBBC1-16ED-4FA8-8B83-83DAED6597B1">
        <RegistryValue Root="HKCU" Key="Software\MegaMek\MegaMek Launcher\Installer"
                       Name="ProgramsFolderOwned" Type="integer" Value="1" KeyPath="yes"/>
        <RemoveFolder Id="RemoveEmptyLauncherProgramsFolder" On="uninstall"/>
      </Component>
    </ComponentGroup>
    <FeatureRef Id="Launcher">
      <ComponentGroupRef Id="LauncherUiState"/>
    </FeatureRef>
    <InstallExecuteSequence>
      <Custom Action="RestoreInstallDir" After="AppSearch"
              Condition="LAUNCHER_PREVIOUS_INSTALLDIR AND NOT INSTALLDIR AND NOT Installed"/>
      <!-- Before RemoveExistingProducts, so a rejected folder leaves the
           current installation untouched. -->
      <Custom Action="ResolveInstallFolder" After="RestoreInstallDir"
              Condition="LAUNCHER_INSTALL_FOLDER AND NOT Installed AND NOT REMOVE"/>
      <!-- AppSearch precedes RemoveExistingProducts (after InstallInitialize).
           UI choice wins in interactive installs; silent upgrades read the old marker.
           The setup bundle seeds its checkbox from the same marker and passes
           LAUNCHER_DESKTOP_CHOSEN, so its (possibly re-checked) choice also wins. -->
      <Custom Action="RestoreDesktopOptOut" After="AppSearch"
              Condition="LAUNCHER_DESKTOP_OPTOUT = 1 AND UILevel &lt; 5 AND NOT Installed AND NOT LAUNCHER_DESKTOP_CHOSEN"/>
    </InstallExecuteSequence>
    <CustomAction Id="SetLauncherTarget" Property="WixShellExecTarget"
                  Value="[INSTALLDIR]MegaMek Launcher.exe"/>
    <CustomAction Id="LaunchMegaMekLauncher" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixShellExec" Impersonate="yes" Return="ignore"/>
    <UI Id="LauncherUI">
      <TextStyle Id="LauncherFont" FaceName="Segoe UI" Size="9"/>
      <Property Id="DefaultUIFont" Value="LauncherFont"/>
      <Property Id="ErrorDialog" Value="LauncherError"/>
      <!-- Windows Installer invokes these two dialogs outside the wizard flow. -->
      <!-- Native error-dialog style lets Windows Installer supply the message,
           select and position its response buttons, and use system error sounds. -->
      <Dialog Id="LauncherError" Width="370" Height="270" Title="!(loc.MmlUiSetupTitle)"
              ErrorDialog="yes">
        <Control Id="ErrorText" Type="Text" X="20" Y="55" Width="330" Height="130"
                 TabSkip="no" NoPrefix="yes" Text="[ErrorText]"/>
        <Control Id="A" Type="PushButton" X="150" Y="243" Width="70" Height="18"
                 TabSkip="yes" Text="!(loc.MmlUiButtonAbort)">
          <Publish Event="EndDialog" Value="ErrorAbort"/>
        </Control>
        <Control Id="C" Type="PushButton" X="150" Y="243" Width="70" Height="18"
                 TabSkip="yes" Text="!(loc.MmlUiButtonCancel)">
          <Publish Event="EndDialog" Value="ErrorCancel"/>
        </Control>
        <Control Id="I" Type="PushButton" X="150" Y="243" Width="70" Height="18"
                 TabSkip="yes" Text="!(loc.MmlUiButtonIgnore)">
          <Publish Event="EndDialog" Value="ErrorIgnore"/>
        </Control>
        <Control Id="N" Type="PushButton" X="150" Y="243" Width="70" Height="18"
                 TabSkip="yes" Text="!(loc.MmlUiButtonNo)">
          <Publish Event="EndDialog" Value="ErrorNo"/>
        </Control>
        <Control Id="O" Type="PushButton" X="150" Y="243" Width="70" Height="18"
                 TabSkip="yes" Text="!(loc.MmlUiButtonOk)">
          <Publish Event="EndDialog" Value="ErrorOk"/>
        </Control>
        <Control Id="R" Type="PushButton" X="150" Y="243" Width="70" Height="18"
                 TabSkip="yes" Text="!(loc.MmlUiButtonRetry)">
          <Publish Event="EndDialog" Value="ErrorRetry"/>
        </Control>
        <Control Id="Y" Type="PushButton" X="150" Y="243" Width="70" Height="18"
                 TabSkip="yes" Text="!(loc.MmlUiButtonYes)">
          <Publish Event="EndDialog" Value="ErrorYes"/>
        </Control>
      </Dialog>
      <Dialog Id="FilesInUse" Width="370" Height="270" Title="!(loc.MmlUiFilesInUseTitle)"
              KeepModeless="yes">
        <Control Id="Message" Type="Text" X="20" Y="32" Width="330" Height="38"
                 Text="!(loc.MmlUiFilesInUseMessage)"/>
        <Control Id="Processes" Type="ListBox" X="20" Y="77" Width="330" Height="116"
                 Property="FileInUseProcess"/>
        <Control Id="Retry" Type="PushButton" X="134" Y="243" Width="64" Height="18"
                 Default="yes" Text="!(loc.MmlUiButtonRetry)">
          <Publish Event="EndDialog" Value="Retry"/>
        </Control>
        <Control Id="Ignore" Type="PushButton" X="205" Y="243" Width="64" Height="18"
                 Text="!(loc.MmlUiButtonIgnore)">
          <Publish Event="EndDialog" Value="Ignore"/>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="276" Y="243" Width="84" Height="18"
                 Cancel="yes" Text="!(loc.MmlUiButtonCancelSetup)">
          <Publish Event="EndDialog" Value="Exit"/>
        </Control>
      </Dialog>
      <Dialog Id="LauncherWelcome" Width="370" Height="270" Title="!(loc.MmlUiSetupTitle)">
        <!-- Artwork occupies only the left strip; the controls sit directly on
             the native light dialog surface, not on a baked image panel. -->
        <Control Id="Art" Type="Bitmap" X="0" Y="0" Width="180" Height="234"
                 Text="WizardDialogArt"/>
        <Control Id="Detail" Type="Text" X="190" Y="46" Width="165" Height="130"
                 Text="!(loc.MmlUiWelcomeDetail)&#10;&#10;[INSTALLDIR]"/>
        <Control Id="DesktopShortcut" Type="CheckBox" X="190" Y="180" Width="165" Height="20"
                 Property="LAUNCHER_DESKTOP_SHORTCUT" CheckBoxValue="1"
                 Text="!(loc.MmlUiWelcomeDesktopShortcut)"/>
        <Control Id="Install" Type="PushButton" X="228" Y="243" Width="66" Height="18"
                 Default="yes" Text="!(loc.MmlUiButtonInstall)">
          <Publish Event="EndDialog" Value="Return"/>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="18"
                 Cancel="yes" Text="!(loc.MmlUiButtonCancel)">
          <Publish Event="EndDialog" Value="Exit"/>
        </Control>
      </Dialog>
      <!-- A Show action before ExecuteAction MUST be modeless: a modal dialog
           without EndDialog blocks the UI sequence and never installs files. -->
      <Dialog Id="LauncherProgress" Width="370" Height="270" Modeless="yes"
              Title="!(loc.MmlUiProgressTitle)">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 Text="WizardBannerArt"/>
        <Control Id="Title" Type="Text" X="15" Y="56" Width="335" Height="24" TabSkip="no"
                 Text="!(loc.MmlUiProgressTitle)"/>
        <!-- The MSI has no ActionText table. Subscribing to the Windows
             Installer fallback messages can display raw tokens such as
             "Files [9]" on localized systems. Keep the label static; the
             independent progress-bar subscription still reports progress. -->
        <Control Id="StatusText" Type="Text" X="15" Y="97" Width="335" Height="22"
                 Text="!(loc.MmlUiProgressStatus)"/>
        <Control Id="ProgressBar" Type="ProgressBar" X="15" Y="126" Width="335" Height="15"
                 ProgressBlocks="yes" Text="!(loc.MmlUiProgressBar)">
          <Subscribe Event="SetProgress" Attribute="Progress"/>
        </Control>
      </Dialog>
      <Dialog Id="Exit" Width="370" Height="270" Title="!(loc.MmlUiExitTitle)">
        <Control Id="Art" Type="Bitmap" X="0" Y="0" Width="180" Height="234"
                 Text="WizardDialogArt"/>
        <Control Id="Title" Type="Text" X="190" Y="46" Width="165" Height="65"
                 Text="!(loc.MmlUiExitInstalled)"/>
        <Control Id="Launch" Type="CheckBox" X="190" Y="148" Width="165" Height="20"
                 Property="LAUNCH_AFTER_INSTALL" CheckBoxValue="1"
                 Text="!(loc.MmlUiExitLaunch)"/>
        <Control Id="Finish" Type="PushButton" X="296" Y="243" Width="64" Height="18"
                 Default="yes" Text="!(loc.MmlUiButtonFinish)">
          <Publish Event="DoAction" Value="SetLauncherTarget" Order="1"
                   Condition="LAUNCH_AFTER_INSTALL = 1 AND UILevel = 5 AND NOT REMOVE"/>
          <Publish Event="DoAction" Value="LaunchMegaMekLauncher" Order="2"
                   Condition="LAUNCH_AFTER_INSTALL = 1 AND UILevel = 5 AND NOT REMOVE"/>
          <Publish Event="EndDialog" Value="Return" Order="3"/>
        </Control>
      </Dialog>
      <Dialog Id="FatalError" Width="370" Height="270" Title="!(loc.MmlUiSetupTitle)">
        <Control Id="Message" Type="Text" X="20" Y="50" Width="330" Height="90"
                 Text="!(loc.MmlUiFatalErrorMessage)"/>
        <Control Id="Close" Type="PushButton" X="296" Y="243" Width="64" Height="18"
                 Default="yes" Text="!(loc.MmlUiButtonClose)">
          <Publish Event="EndDialog" Value="Return"/>
        </Control>
      </Dialog>
      <Dialog Id="UserExit" Width="370" Height="270" Title="!(loc.MmlUiSetupTitle)">
        <Control Id="Message" Type="Text" X="20" Y="50" Width="330" Height="90"
                 Text="!(loc.MmlUiUserExitMessage)"/>
        <Control Id="Close" Type="PushButton" X="296" Y="243" Width="64" Height="18"
                 Default="yes" Text="!(loc.MmlUiButtonClose)">
          <Publish Event="EndDialog" Value="Return"/>
        </Control>
      </Dialog>
      <InstallUISequence>
        <Custom Action="RestoreInstallDir" After="AppSearch"
                Condition="LAUNCHER_PREVIOUS_INSTALLDIR AND NOT INSTALLDIR AND NOT Installed"/>
        <Custom Action="RestoreDesktopOptOut" After="AppSearch"
                Condition="LAUNCHER_DESKTOP_OPTOUT = 1 AND NOT Installed"/>
        <Show Dialog="LauncherWelcome" Before="LauncherProgress" Condition="NOT Installed"/>
        <Show Dialog="LauncherProgress" Before="ExecuteAction" Condition="NOT Installed"/>
        <Show Dialog="Exit" OnExit="success" Condition="NOT REMOVE"/>
        <Show Dialog="FatalError" OnExit="error"/>
        <Show Dialog="UserExit" OnExit="cancel"/>
      </InstallUISequence>
      <AdminUISequence>
        <Show Dialog="Exit" OnExit="success"/>
        <Show Dialog="FatalError" OnExit="error"/>
        <Show Dialog="UserExit" OnExit="cancel"/>
      </AdminUISequence>
    </UI>
  </Fragment>
</Wix>

