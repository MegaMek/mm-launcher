<!-- jpackage/WiX 3 UI override. Per-user install; the user may choose the parent
     folder, and the launcher always installs into its own "MegaMek Launcher"
     subfolder because jpackage's RemoveFolderEx deletes INSTALLDIR recursively
     on uninstall. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <Binary Id="LauncherWizardDialog" SourceFile="$(env.MM_LAUNCHER_ART_DIR)/wizard-dialog.bmp"/>
    <Binary Id="LauncherWizardBanner" SourceFile="$(env.MM_LAUNCHER_ART_DIR)/wizard-banner.bmp"/>
    <Property Id="LAUNCH_AFTER_INSTALL" Value="1"/>
    <!-- jpackage owns the DesktopFolder shortcut. Its component is conditional on
         JP_INSTALL_DESKTOP_SHORTCUT; only persist the opt-out, not a second shortcut. -->
    <Property Id="LAUNCHER_DESKTOP_OPTOUT">
      <RegistrySearch Id="PreviousDesktopOptOut" Root="HKCU"
                      Key="Software\MegaMek\MegaMek Launcher\Installer"
                      Name="DesktopShortcutOptOut" Type="raw"/>
    </Property>
    <CustomAction Id="RestoreDesktopOptOut" Property="JP_INSTALL_DESKTOP_SHORTCUT"
                  Value="{}"/>
    <!-- Remember the chosen folder so upgrades, including the launcher's silent
         self-update, install over the same folder instead of the default one. -->
    <Property Id="LAUNCHER_PREVIOUS_INSTALLDIR">
      <RegistrySearch Id="PreviousInstallDir" Root="HKCU"
                      Key="Software\MegaMek\MegaMek Launcher\Installer"
                      Name="InstallDir" Type="raw"/>
    </Property>
    <!-- Directory properties stay empty until CostFinalize, so an empty INSTALLDIR
         here means the command line did not choose a folder explicitly. -->
    <CustomAction Id="RestoreInstallDir" Property="INSTALLDIR"
                  Value="[LAUNCHER_PREVIOUS_INSTALLDIR]"/>
    <!-- Built by the windowsInstallerFolderPicker Gradle task (WiX DTF, C#). -->
    <Binary Id="LauncherPickerCA"
            SourceFile="$(env.MM_LAUNCHER_CA_DIR)/LauncherFolderPicker.CA.dll"/>
    <CustomAction Id="LauncherPickFolder" BinaryKey="LauncherPickerCA"
                  DllEntry="PickInstallFolder" Execute="immediate" Return="ignore"/>
    <DirectoryRef Id="TARGETDIR">
      <Component Id="DesktopOptOutPreference" Guid="8B67C1E0-7B4B-4DC3-95D0-F19EBA63BB36">
        <Condition>NOT JP_INSTALL_DESKTOP_SHORTCUT</Condition>
        <RegistryValue Root="HKCU" Key="Software\MegaMek\MegaMek Launcher\Installer"
                       Name="DesktopShortcutOptOut" Type="string" Value="1" KeyPath="yes"/>
      </Component>
      <Component Id="InstallDirPreference" Guid="5C0E3F0A-5D8B-4C43-9E0B-2B8D7A3E61C4">
        <RegistryValue Root="HKCU" Key="Software\MegaMek\MegaMek Launcher\Installer"
                       Name="InstallDir" Type="string" Value="[INSTALLDIR]" KeyPath="yes"/>
      </Component>
    </DirectoryRef>
    <!-- build.gradle.kts WindowsInstallerMsi passes the install-dir argument
         Programs/MegaMek Launcher. The generated jpackage MSI Directory table
         has TARGETDIR / LocalAppDataFolder / dir3b50371ef2d03bb0b1971278ecbab3a3
         (Name=Programs) / INSTALLDIR (Name=MegaMek Launcher).
         This is jpackage's generated ID, not one derived here: if jpackage
         changes it, inspect the new Directory table before updating this ref.
         Remove only the empty installer-owned Programs directory; never its
         contents or the containing LocalAppDataFolder. RemoveFolder leaves a
         non-empty folder alone, so this is also safe when the user picked a
         different install folder. -->
    <DirectoryRef Id="dir3b50371ef2d03bb0b1971278ecbab3a3">
      <Component Id="LauncherProgramsFolderCleanup" Guid="B65FBBC1-16ED-4FA8-8B83-83DAED6597B1">
        <RegistryValue Root="HKCU" Key="Software\MegaMek\MegaMek Launcher\Installer"
                       Name="ProgramsFolderOwned" Type="integer" Value="1" KeyPath="yes"/>
        <RemoveFolder Id="RemoveEmptyLauncherProgramsFolder" On="uninstall"/>
      </Component>
    </DirectoryRef>
    <FeatureRef Id="DefaultFeature">
      <ComponentRef Id="DesktopOptOutPreference"/>
      <ComponentRef Id="InstallDirPreference"/>
      <ComponentRef Id="LauncherProgramsFolderCleanup"/>
    </FeatureRef>
    <InstallExecuteSequence>
      <Custom Action="RestoreInstallDir" After="AppSearch">
        LAUNCHER_PREVIOUS_INSTALLDIR AND NOT INSTALLDIR AND NOT Installed
      </Custom>
      <!-- AppSearch precedes jpackage's early RemoveExistingProducts (sequence 798).
           UI choice wins in interactive installs; silent upgrades read the old marker. -->
      <Custom Action="RestoreDesktopOptOut" After="AppSearch">
        LAUNCHER_DESKTOP_OPTOUT = 1 AND UILevel &lt; 5 AND NOT Installed
      </Custom>
    </InstallExecuteSequence>
    <CustomAction Id="SetLauncherTarget" Property="WixShellExecTarget"
                  Value="[INSTALLDIR]MegaMek Launcher.exe"/>
    <CustomAction Id="LaunchMegaMekLauncher" BinaryKey="WixCA"
                  DllEntry="WixShellExec" Impersonate="yes" Return="ignore"/>
    <UI Id="JpUI">
      <TextStyle Id="LauncherFont" FaceName="Segoe UI" Size="9"/>
      <TextStyle Id="LauncherHint" FaceName="Segoe UI" Size="8" Red="96" Green="96" Blue="96"/>
      <Property Id="DefaultUIFont" Value="LauncherFont"/>
      <Property Id="ErrorDialog" Value="LauncherError"/>
      <!-- Windows Installer invokes these two dialogs outside the wizard flow. -->
      <!-- Native error-dialog style lets Windows Installer supply the message,
           select and position its response buttons, and use system error sounds. -->
      <Dialog Id="LauncherError" Width="370" Height="270" Title="!(loc.MmlUiSetupTitle)"
              ErrorDialog="yes">
        <Control Id="ErrorText" Type="Text" X="20" Y="55" Width="330" Height="130"
                 TabSkip="no" NoPrefix="yes" Text="[ErrorText]"/>
        <Control Id="A" Type="PushButton" X="150" Y="243" Width="70" Height="18"
                 TabSkip="yes" Text="!(loc.MmlUiButtonAbort)">
          <Publish Event="EndDialog" Value="ErrorAbort">1</Publish>
        </Control>
        <Control Id="C" Type="PushButton" X="150" Y="243" Width="70" Height="18"
                 TabSkip="yes" Text="!(loc.MmlUiButtonCancel)">
          <Publish Event="EndDialog" Value="ErrorCancel">1</Publish>
        </Control>
        <Control Id="I" Type="PushButton" X="150" Y="243" Width="70" Height="18"
                 TabSkip="yes" Text="!(loc.MmlUiButtonIgnore)">
          <Publish Event="EndDialog" Value="ErrorIgnore">1</Publish>
        </Control>
        <Control Id="N" Type="PushButton" X="150" Y="243" Width="70" Height="18"
                 TabSkip="yes" Text="!(loc.MmlUiButtonNo)">
          <Publish Event="EndDialog" Value="ErrorNo">1</Publish>
        </Control>
        <Control Id="O" Type="PushButton" X="150" Y="243" Width="70" Height="18"
                 TabSkip="yes" Text="!(loc.MmlUiButtonOk)">
          <Publish Event="EndDialog" Value="ErrorOk">1</Publish>
        </Control>
        <Control Id="R" Type="PushButton" X="150" Y="243" Width="70" Height="18"
                 TabSkip="yes" Text="!(loc.MmlUiButtonRetry)">
          <Publish Event="EndDialog" Value="ErrorRetry">1</Publish>
        </Control>
        <Control Id="Y" Type="PushButton" X="150" Y="243" Width="70" Height="18"
                 TabSkip="yes" Text="!(loc.MmlUiButtonYes)">
          <Publish Event="EndDialog" Value="ErrorYes">1</Publish>
        </Control>
      </Dialog>
      <Dialog Id="FilesInUse" Width="370" Height="270" Title="!(loc.MmlUiFilesInUseTitle)"
              KeepModeless="yes">
        <Control Id="Message" Type="Text" X="20" Y="32" Width="330" Height="38"
                 Text="!(loc.MmlUiFilesInUseMessage)"/>
        <Control Id="Processes" Type="ListBox" X="20" Y="77" Width="330" Height="116"
                 Property="FileInUseProcess"/>
        <Control Id="Retry" Type="PushButton" X="134" Y="243" Width="64" Height="18"
                 Default="yes" Text="!(loc.MmlUiButtonRetry)">
          <Publish Event="EndDialog" Value="Retry">1</Publish>
        </Control>
        <Control Id="Ignore" Type="PushButton" X="205" Y="243" Width="64" Height="18"
                 Text="!(loc.MmlUiButtonIgnore)">
          <Publish Event="EndDialog" Value="Ignore">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="276" Y="243" Width="84" Height="18"
                 Cancel="yes" Text="!(loc.MmlUiButtonCancelSetup)">
          <Publish Event="EndDialog" Value="Exit">1</Publish>
        </Control>
      </Dialog>
      <Dialog Id="LauncherWelcome" Width="490" Height="270" Title="!(loc.MmlUiSetupTitle)">
        <!-- Artwork occupies only the left strip; the controls sit directly on
             the native light dialog surface, not on a baked image panel. -->
        <Control Id="Art" Type="Bitmap" X="0" Y="0" Width="180" Height="234"
                 Text="LauncherWizardDialog"/>
        <Control Id="Detail" Type="Text" X="190" Y="46" Width="285" Height="14"
                 Text="!(loc.MmlUiWelcomeDetail)"/>
        <Control Id="Folder" Type="Text" X="190" Y="64" Width="285" Height="17" Sunken="yes"
                 NoPrefix="yes" Text="[INSTALLDIR]"/>
        <Control Id="GamesHint" Type="Text" X="190" Y="84" Width="285" Height="12" NoPrefix="yes"
                 Text="{\LauncherHint}!(loc.MmlUiWelcomeGamesHint)"/>
        <!-- The custom action shows the standard Windows folder dialog and always
             returns a dedicated "MegaMek Launcher" folder inside the user's pick:
             jpackage's uninstall removes INSTALLDIR recursively. -->
        <Control Id="ChangeFolder" Type="PushButton" X="409" Y="102" Width="66" Height="18"
                 Text="!(loc.MmlUiButtonChange)">
          <Publish Event="DoAction" Value="LauncherPickFolder" Order="1">1</Publish>
          <Publish Property="INSTALLDIR" Value="[LAUNCHER_PICKED_DIR]" Order="2">
            LAUNCHER_PICKED_DIR
          </Publish>
          <Publish Event="SetTargetPath" Value="INSTALLDIR" Order="3">LAUNCHER_PICKED_DIR</Publish>
          <Publish Event="NewDialog" Value="LauncherWelcomeRefresh" Order="4">LAUNCHER_PICKED_DIR</Publish>
        </Control>
        <Control Id="DesktopShortcut" Type="CheckBox" X="190" Y="101" Width="165" Height="20"
                 Property="JP_INSTALL_DESKTOP_SHORTCUT" CheckBoxValue="1"
                 Text="!(loc.MmlUiWelcomeDesktopShortcut)"/>
        <Control Id="Install" Type="PushButton" X="348" Y="243" Width="66" Height="18"
                 Default="yes" Text="!(loc.MmlUiButtonInstall)">
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="424" Y="243" Width="56" Height="18"
                 Cancel="yes" Text="!(loc.MmlUiButtonCancel)">
          <Publish Event="EndDialog" Value="Exit">1</Publish>
        </Control>
      </Dialog>
      <!-- MSI never redraws a dialog's text after a DoAction, and NewDialog to the
           current dialog is a no-op. Change... switches between these two identical
           dialogs so the Folder text shows the newly chosen path. The CheckBox table
           is keyed by property, so the copy reuses it with CheckBoxPropertyRef. -->
      <Dialog Id="LauncherWelcomeRefresh" Width="490" Height="270" Title="!(loc.MmlUiSetupTitle)">
        <Control Id="Art" Type="Bitmap" X="0" Y="0" Width="180" Height="234"
                 Text="LauncherWizardDialog"/>
        <Control Id="Detail" Type="Text" X="190" Y="46" Width="285" Height="14"
                 Text="!(loc.MmlUiWelcomeDetail)"/>
        <Control Id="Folder" Type="Text" X="190" Y="64" Width="285" Height="17" Sunken="yes"
                 NoPrefix="yes" Text="[INSTALLDIR]"/>
        <Control Id="GamesHint" Type="Text" X="190" Y="84" Width="285" Height="12" NoPrefix="yes"
                 Text="{\LauncherHint}!(loc.MmlUiWelcomeGamesHint)"/>
        <Control Id="ChangeFolder" Type="PushButton" X="409" Y="102" Width="66" Height="18"
                 Text="!(loc.MmlUiButtonChange)">
          <Publish Event="DoAction" Value="LauncherPickFolder" Order="1">1</Publish>
          <Publish Property="INSTALLDIR" Value="[LAUNCHER_PICKED_DIR]" Order="2">
            LAUNCHER_PICKED_DIR
          </Publish>
          <Publish Event="SetTargetPath" Value="INSTALLDIR" Order="3">LAUNCHER_PICKED_DIR</Publish>
          <Publish Event="NewDialog" Value="LauncherWelcome" Order="4">LAUNCHER_PICKED_DIR</Publish>
        </Control>
        <Control Id="DesktopShortcut" Type="CheckBox" X="190" Y="101" Width="165" Height="20"
                 CheckBoxPropertyRef="JP_INSTALL_DESKTOP_SHORTCUT"
                 Text="!(loc.MmlUiWelcomeDesktopShortcut)"/>
        <Control Id="Install" Type="PushButton" X="348" Y="243" Width="66" Height="18"
                 Default="yes" Text="!(loc.MmlUiButtonInstall)">
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="424" Y="243" Width="56" Height="18"
                 Cancel="yes" Text="!(loc.MmlUiButtonCancel)">
          <Publish Event="EndDialog" Value="Exit">1</Publish>
        </Control>
      </Dialog>
      <!-- A Show action before ExecuteAction MUST be modeless: a modal dialog
           without EndDialog blocks the UI sequence and never installs files. -->
      <Dialog Id="LauncherProgress" Width="490" Height="270" Modeless="yes"
              Title="!(loc.MmlUiProgressTitle)">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="490" Height="44"
                 Text="LauncherWizardBanner"/>
        <Control Id="Title" Type="Text" X="15" Y="56" Width="455" Height="24" TabSkip="no"
                 Text="!(loc.MmlUiProgressTitle)"/>
        <!-- The generated MSI has no ActionText table. Subscribing to the
             Windows Installer fallback messages can display raw tokens such
             as "Files [9]" on localized systems. Keep the label static; the
             independent progress-bar subscription still reports progress. -->
        <Control Id="StatusText" Type="Text" X="15" Y="97" Width="455" Height="22"
                 Text="!(loc.MmlUiProgressStatus)"/>
        <Control Id="ProgressBar" Type="ProgressBar" X="15" Y="126" Width="455" Height="15"
                 ProgressBlocks="yes" Text="!(loc.MmlUiProgressBar)">
          <Subscribe Event="SetProgress" Attribute="Progress"/>
        </Control>
      </Dialog>
      <Dialog Id="Exit" Width="490" Height="270" Title="!(loc.MmlUiExitTitle)">
        <Control Id="Art" Type="Bitmap" X="0" Y="0" Width="180" Height="234"
                 Text="LauncherWizardDialog"/>
        <Control Id="Title" Type="Text" X="190" Y="46" Width="285" Height="15"
                 Text="!(loc.MmlUiExitInstalled)"/>
        <Control Id="Launch" Type="CheckBox" X="190" Y="66" Width="165" Height="20"
                 Property="LAUNCH_AFTER_INSTALL" CheckBoxValue="1"
                 Text="!(loc.MmlUiExitLaunch)"/>
        <Control Id="Finish" Type="PushButton" X="416" Y="243" Width="64" Height="18"
                 Default="yes" Text="!(loc.MmlUiButtonFinish)">
          <Publish Event="DoAction" Value="SetLauncherTarget" Order="1">
            LAUNCH_AFTER_INSTALL = 1 AND UILevel = 5 AND NOT REMOVE
          </Publish>
          <Publish Event="DoAction" Value="LaunchMegaMekLauncher" Order="2">
            LAUNCH_AFTER_INSTALL = 1 AND UILevel = 5 AND NOT REMOVE
          </Publish>
          <Publish Event="EndDialog" Value="Return" Order="3">1</Publish>
        </Control>
      </Dialog>
      <Dialog Id="FatalError" Width="490" Height="270" Title="!(loc.MmlUiSetupTitle)">
        <Control Id="Message" Type="Text" X="20" Y="50" Width="450" Height="90"
                 Text="!(loc.MmlUiFatalErrorMessage)"/>
        <Control Id="Close" Type="PushButton" X="416" Y="243" Width="64" Height="18"
                 Default="yes" Text="!(loc.MmlUiButtonClose)">
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
      </Dialog>
      <Dialog Id="UserExit" Width="490" Height="270" Title="!(loc.MmlUiSetupTitle)">
        <Control Id="Message" Type="Text" X="20" Y="50" Width="450" Height="90"
                 Text="!(loc.MmlUiUserExitMessage)"/>
        <Control Id="Close" Type="PushButton" X="416" Y="243" Width="64" Height="18"
                 Default="yes" Text="!(loc.MmlUiButtonClose)">
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
      </Dialog>
      <InstallUISequence>
        <Custom Action="RestoreInstallDir" After="AppSearch">
          LAUNCHER_PREVIOUS_INSTALLDIR AND NOT INSTALLDIR AND NOT Installed
        </Custom>
        <Custom Action="RestoreDesktopOptOut" After="AppSearch">
          LAUNCHER_DESKTOP_OPTOUT = 1 AND NOT Installed
        </Custom>
        <Show Dialog="LauncherWelcome" Before="LauncherProgress">NOT Installed</Show>
        <Show Dialog="LauncherProgress" Before="ExecuteAction">NOT Installed</Show>
        <Show Dialog="Exit" OnExit="success">NOT REMOVE</Show>
        <Show Dialog="FatalError" OnExit="error">1</Show>
        <Show Dialog="UserExit" OnExit="cancel">1</Show>
      </InstallUISequence>
      <AdminUISequence>
        <Show Dialog="Exit" OnExit="success">1</Show>
        <Show Dialog="FatalError" OnExit="error">1</Show>
        <Show Dialog="UserExit" OnExit="cancel">1</Show>
      </AdminUISequence>
    </UI>
  </Fragment>
</Wix>
