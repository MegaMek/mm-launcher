<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
"http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
    <vendor>MegaMek</vendor>
    <vendor_url>https://megamek.org</vendor_url>

    <action id="org.megamek.launcher.DesktopLauncher.update">
        <description>Update MegaMek Launcher</description>
        <message>Authentication is required by your package manager to update MegaMek Launcher</message>
        <icon_name>software-update-available</icon_name>
        <defaults>
            <allow_any>auth_admin</allow_any>
            <allow_inactive>auth_admin</allow_inactive>
            <allow_active>yes</allow_active>
        </defaults>
        <annotate key="org.freedesktop.policykit.exec.path">/opt/megamek-launcher/lib/perform-update</annotate>
    </action>
</policyconfig>
