#!/bin/sh
set -eu

APP_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
SHARED_LIB="$APP_ROOT/MM Launcher.app/Contents/app/lib"

find_java() {
    if [ -n "${JAVA_HOME:-}" ]; then
        if [ ! -x "${JAVA_HOME}/bin/java" ]; then
            printf '%s\n' "MM Launcher: JAVA_HOME does not contain an executable bin/java." >&2
            return 1
        fi
        printf '%s\n' "${JAVA_HOME}/bin/java"
        return 0
    fi
    command -v java 2>/dev/null || return 1
}

JAVA_COMMAND=$(find_java) || {
    printf '%s\n' "MM Launcher requires an external Java 21 or newer runtime." >&2
    exit 2
}

JAVA_FEATURE=$(
    "$JAVA_COMMAND" -XshowSettings:properties -version 2>&1 |
        sed -n 's/^[[:space:]]*java\.version = \([0-9][0-9]*\).*/\1/p' |
        sed -n '1p'
)
case "$JAVA_FEATURE" in
    ''|*[!0-9]*)
        printf '%s\n' "MM Launcher could not determine the selected Java version." >&2
        exit 2
        ;;
esac
if [ "$JAVA_FEATURE" -lt 21 ]; then
    printf '%s\n' "MM Launcher requires Java 21 or newer; found Java ${JAVA_FEATURE}." >&2
    exit 2
fi

unset JDK_JAVA_OPTIONS JAVA_TOOL_OPTIONS _JAVA_OPTIONS
exec "$JAVA_COMMAND" -cp "$SHARED_LIB/*" org.megamek.launcher.DesktopLauncher "$@"
