#!/bin/sh
# postinst script for APPLICATION_PACKAGE
#
# Replaces jpackage's template so menu entries are registered by
# /opt/megamek-launcher/lib/desktop-entries/desktop-integration.sh.
# see: dh_installdeb(1)

set -e

case "$1" in
    # Abort cases restore entries that prerm removed before the transaction rolled back.
    configure|abort-upgrade|abort-remove|abort-deconfigure)
        sh /opt/megamek-launcher/lib/desktop-entries/desktop-integration.sh install
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0
